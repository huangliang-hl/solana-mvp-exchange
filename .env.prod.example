# 生产环境配置示例
# 复制此文件为 .env.prod 并填写实际值

# 数据库配置
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Redis 配置
REDIS_PASSWORD=your_secure_redis_password_here

# Solana 配置
RPC_URL=https://api.mainnet-beta.solana.com
PRIVATE_KEY=your_mainnet_private_key_here

# Jupiter 配置
JUPITER_ENDPOINT=https://quote-api.jup.ag/v6

# 服务端口配置
API_PORT=8080
PRICE_PORT=8081

# 日志级别
LOG_LEVEL=warn

# API 密钥（用逗号分隔多个）
API_KEYS=your_secure_api_key_1,your_secure_api_key_2

# 执行器配置
WORKER_COUNT=5
JUPITER_MOCK_ENABLED=false

# 数据库配置
DB_URL=postgres://postgres:password@localhost:5432/solana_limit_order?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1
DB_MAX_CONN_IDLE_TIME=30

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# Solana 配置
RPC_URL=https://api.devnet.solana.com
PRIVATE_KEY=your_base58_private_key_here

# Jupiter 配置
JUPITER_ENDPOINT=https://quote-api.jup.ag/v6

# Jupiter 模拟器配置（devnet 环境建议启用）
JUPITER_MOCK_ENABLED=true
JUPITER_MOCK_SUCCESS_RATE=1.0
JUPITER_MOCK_LATENCY_MS=100
JUPITER_MOCK_MIN_SLIPPAGE=0.1
JUPITER_MOCK_MAX_SLIPPAGE=1.0

# 服务绑定地址
API_BIND=0.0.0.0:8080
PRICE_WS_BIND=0.0.0.0:8081

# HTTP 服务器配置
HTTP_READ_TIMEOUT=15
HTTP_WRITE_TIMEOUT=15
HTTP_IDLE_TIMEOUT=60

# 执行器配置
WORKER_COUNT=3
WORKER_CONSUMER_TIMEOUT=5
ORDER_EXECUTION_TIMEOUT=30
HEALTH_CHECK_INTERVAL=30

# 价格模拟器配置
PRICE_SIMULATOR_SYMBOL=SOL/USDC
PRICE_SIMULATOR_BASE_PRICE=30.0
PRICE_SIMULATOR_VOLATILITY=0.02
PRICE_SIMULATOR_TICK_INTERVAL=1000
PRICE_SIMULATOR_SPREAD=0.1

# WebSocket 配置
WS_READ_TIMEOUT=60
WS_WRITE_TIMEOUT=10
WS_PING_INTERVAL=54

# 运行模式
MODE=dev

# 日志级别
LOG_LEVEL=info

# API 密钥（示例）
API_KEYS=test-key-1,test-key-2
